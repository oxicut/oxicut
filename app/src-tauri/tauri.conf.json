{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxiCut",
  "mainBinaryName": "oxicut-app",
  "identifier": "app.oxicut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OxiCut",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OxiCut",
    "copyright": "Free software under the GPL-3.0",
    "shortDescription": "Cuts scanned photos apart into separate, straightened pictures",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["oxicut"],
        "name": "OxiCut project",
        "description": "OxiCut project",
        "role": "Editor",
        "mimeType": "application/vnd.oxicut+json"
      }
    ]
  }
}
